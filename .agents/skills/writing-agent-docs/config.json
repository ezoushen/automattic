{
  "docs": [
    "skills/**/*.md",
    "harnesses/**/*.md",
    "agents/*.md",
    ".agents/skills/**/*.md",
    "bootstrap.md",
    "flows/**/*.md",
    "standards/**/*.md",
    "runtime/**/*.md",
    "hosts/**/*.md"
  ],
  "linking": [
    "README.md",
    "docs/**/*.md",
    "addons/**/*.md"
  ],
  "code": [
    "scripts/*.py",
    "scripts/*.sh",
    "hooks/*.py",
    "hooks/*.json",
    "tests/*.py",
    "tests/*.mjs",
    "hosts/**/*.ts",
    "hosts/**/*.json"
  ],
  "exclude": [
    "tests/test_doc_checker.py",
    "tests/test_git_hooks.py",
    "tests/test_pre_push.py",
    "tests/test_pre_push_signals.py",
    "tests/hook_case.py",
    "tests/test_agent_definitions.py",
    "tests/test_architecture_rules.py",
    "tests/test_fold_check.py"
  ],
  "code_doc_pattern": "(?<![\\w/.-])(?:(?:harnesses|skills|agents|flows|standards|runtime|hosts)/[\\w/-]+|bootstrap)\\.md",
  "entry_points": [
    "skills/*/SKILL.md",
    "agents/*.md",
    ".agents/skills/*/SKILL.md",
    "bootstrap.md",
    "hosts/*/session.md",
    "flows/*/jobs/*.md"
  ],
  "skill_files": [
    "skills/*/SKILL.md",
    ".agents/skills/*/SKILL.md"
  ],
  "known_names": [
    "AGENTS.md",
    "CLAUDE.md",
    "CONTEXT.md",
    "GLOSSARY.md"
  ],
  "max_bytes": 12288,
  "description_budget": 4000,
  "debt": {},
  "architecture": "architecture.json"
}
