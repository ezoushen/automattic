{
  "docs": [
    "skills/**/*.md",
    "harnesses/**/*.md",
    "agents/*.md",
    ".agents/skills/**/*.md"
  ],
  "linking": [
    "README.md",
    "docs/**/*.md",
    "addons/**/*.md"
  ],
  "code": [
    "scripts/*.py",
    "scripts/*.sh",
    "hooks/*.py",
    "hooks/*.json",
    "harnesses/**/*.ts",
    "harnesses/**/*.json",
    "tests/*.py",
    "tests/*.mjs"
  ],
  "exclude": [
    "tests/test_doc_checker.py",
    "tests/test_git_hooks.py",
    "tests/test_pre_push.py",
    "tests/test_pre_push_signals.py",
    "tests/hook_case.py",
    "tests/test_agent_definitions.py"
  ],
  "code_doc_pattern": "(?:harnesses|skills|agents)/[\\w/-]+\\.md",
  "entry_points": [
    "skills/*/SKILL.md",
    "harnesses/*/adapter.md",
    "agents/*.md",
    ".agents/skills/*/SKILL.md",
    "skills/*/jobs/*.md"
  ],
  "skill_files": [
    "skills/*/SKILL.md",
    ".agents/skills/*/SKILL.md"
  ],
  "known_names": [
    "AGENTS.md",
    "CLAUDE.md",
    "CONTEXT.md",
    "GLOSSARY.md"
  ],
  "max_bytes": 12288,
  "description_budget": 4000,
