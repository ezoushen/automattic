{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bash executor configuration",
  "type": "object",
  "properties": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [{ "type": "string", "minLength": 1, "not": { "pattern": "\\u0000" } }],
      "items": { "type": "string", "not": { "pattern": "\\u0000" } }
    }
  },
  "required": ["argv"],
  "additionalProperties": false
}
