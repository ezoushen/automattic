{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automattic bounded decision request",
  "type": "object",
  "properties": {
    "family": {"enum": ["mandate", "alignment", "refinement", "worker-selection", "review-triage", "recovery", "delivery", "failure-cause", "wake-triage", "test-shape"]},
    "state": {"type": "string", "pattern": "\\S", "maxLength": 16000},
    "instruction": {"type": "string", "pattern": "\\S", "maxLength": 16000},
    "images": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "label"],
        "properties": {
          "path": {"type": "string", "pattern": "^/[^\\u0000]*$", "maxLength": 4096},
          "label": {"type": "string", "pattern": "\\S", "maxLength": 240}
        }
      }
    },
    "options": {
      "type": "object", "minProperties": 1, "maxProperties": 254,
      "propertyNames": {"pattern": "\\S", "not": {"const": "abstain"}},
      "additionalProperties": {"type": "string", "pattern": "\\S"}
    }
  },
  "required": ["family", "state", "instruction", "options"],
  "additionalProperties": false,
  "allOf": [{
    "if": {"properties": {"family": {"const": "recovery"}}},
    "then": {"properties": {"options": {"propertyNames": {
      "enum": ["retain-worker", "supply-context", "repair-environment", "replan", "reselect-worker"]
    }}}}
  }]
}
