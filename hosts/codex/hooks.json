{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\" codex",
            "timeout": 5,
            "statusMessage": "Automattic: load bootstrap and host adapter"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/herdr_launch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/yield_gate.py\" codex",
            "timeout": 20,
            "statusMessage": "Automattic: yield gate for live workers"
          }
        ]
      }
    ]
  }
}
